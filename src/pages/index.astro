---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/shared/paths';
import { TOOLS, toolHref } from '@/lib/shared/tools';

const pageTitle = 'PlainKit';
const description =
  'Free everyday tools that run entirely in your browser. No ads, no tracking, no accounts, nothing uploaded.';
---

<BaseLayout title={pageTitle} description={description} wide>
  <h1 class="index-title">Small tools that run entirely in your browser</h1>
  <p class="index-intro">
    No ads, no tracking, no accounts. Nothing you type is sent anywhere — every calculation happens
    on your own device.
  </p>

  {TOOLS.length > 0 ? (
    <ul class="index-list">
      {TOOLS.map((item) => (
        <li>
          <a class="index-card" href={toolHref(item.slug)}>
            <span class="eyebrow">{item.category}</span>
            <span class="index-card__title">{item.title}</span>
            <span class="index-card__summary">{item.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="index-empty">
      The first tools are being built right now. In the meantime, you can read{' '}
      <a href={href('about/')}>how this works</a>.
    </p>
  )}
</BaseLayout>

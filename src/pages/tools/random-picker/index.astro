---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Random group & name picker';
const description =
  'Paste a list of names and split it into random groups, draw names without repeats, or shuffle the order. Free, no ads, nothing leaves your device.';
const summary =
  'Random groups, name draws and shuffles from any list — with a result card worth sharing.';
---

<BaseLayout title={pageTitle} description={description} tool="random-picker">
  <article class="tool" id="tool">
    <header class="tool__head">
      <p class="eyebrow">Randomness</p>
      <h1 class="tool__title">{pageTitle}</h1>
      <p class="tool__lead">{summary}</p>
    </header>

    <section class="bench">
      <div class="bench__rule" aria-hidden="true"></div>

      <div class="bench__fields" id="fields">
        <div class="bench__field">
          <label class="bench__label" for="names">
            Names{' '}
            <span class="bench__label-hint" id="names-count">
              0 names
            </span>
          </label>
          <textarea
            class="bench__input bench__input--area"
            id="names"
            name="names"
            rows="8"
            autocomplete="off"
            spellcheck="false"
            placeholder="One name per line — Alice:8 for a rating"
            aria-describedby="names-hint dup-warning"
          ></textarea>
          <p class="bench__error" id="names-hint" role="status"></p>
          <p class="bench__error bench__error--action" id="dup-warning" hidden>
            <span id="dup-names"></span>
            <button type="button" class="link-btn" id="dedupe">
              Remove duplicates
            </button>
          </p>
          <p class="bench__note" id="team-notes" role="status"></p>
          <button type="button" class="link-btn bench__clear" id="clear">
            Clear list
          </button>
        </div>

        <div class="bench__field">
          <span class="bench__label" id="mode-label">
            Mode
          </span>
          <div class="mode-switch" role="radiogroup" aria-labelledby="mode-label">
            <label class="mode-switch__option">
              <input type="radio" name="mode" id="mode-groups" value="groups" checked />
              <span>Groups</span>
            </label>
            <label class="mode-switch__option">
              <input type="radio" name="mode" id="mode-pick" value="pick" />
              <span>Pick names</span>
            </label>
            <label class="mode-switch__option">
              <input type="radio" name="mode" id="mode-order" value="order" />
              <span>Random order</span>
            </label>
            <label class="mode-switch__option">
              <input type="radio" name="mode" id="mode-teams" value="teams" />
              <span>Teams</span>
            </label>
            <label class="mode-switch__option">
              <input type="radio" name="mode" id="mode-wheel" value="wheel" />
              <span>Wheel</span>
            </label>
          </div>
        </div>

        <div class="bench__field" id="group-by-field">
          <label class="bench__label" for="group-by">
            Split by
          </label>
          <select class="bench__input" id="group-by" name="group-by">
            <option value="count">Number of groups</option>
            <option value="size">People per group</option>
          </select>
        </div>

        <div class="bench__field" id="param-field">
          <label class="bench__label" for="param" id="param-label">
            Number of groups
          </label>
          <input
            class="bench__input"
            id="param"
            name="param"
            type="number"
            min="1"
            step="1"
            value="4"
            autocomplete="off"
            aria-describedby="param-error"
          />
          <p class="bench__error" id="param-error"></p>
        </div>

        <!-- 转盘模式：盘面 + 连抽开关（AC-042 / 046）。图形是视觉辅助，
             中签结果由下方读数用 aria-live 播报，所以图形对读屏器隐藏。 -->
        <div class="bench__field" id="wheel-field" hidden>
          <div class="wheel" id="wheel-stage">
            <svg class="wheel__svg" id="wheel-svg" viewBox="0 0 320 320" aria-hidden="true">
              <g id="wheel-rotor"></g>
            </svg>
            <svg class="wheel__pointer" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22 L4 4 L20 4 Z" />
            </svg>
          </div>
          <label class="wheel__toggle">
            <input type="checkbox" id="wheel-remove" />
            <span>Remove winner after each spin</span>
          </label>
          <p class="bench__note" id="wheel-notes" role="status"></p>
          <button type="button" class="link-btn wheel__reset" id="wheel-reset" hidden>
            Reset wheel
          </button>
        </div>

        <div class="bench__field">
          <button type="button" class="btn" data-variant="primary" id="generate" disabled>
            Generate
          </button>
        </div>
      </div>

      <output class="readout" id="readout" data-state="pending" aria-live="polite">
        <p class="readout__label">Result</p>
        <p class="readout__value" id="readout-value" hidden></p>
        <div class="result" id="result" hidden></div>
        <p class="readout__note" id="readout-note">
          Enter at least 2 names, then press Generate.
        </p>
      </output>

      <div class="tool__actions">
        <button type="button" class="btn" data-variant="primary" id="regenerate" disabled>
          Regenerate
        </button>
        <button type="button" class="btn" id="copy-text" disabled>
          Copy text
        </button>
        <button type="button" class="btn" id="download-image" disabled>
          Download image
        </button>
      </div>
    </section>

    <section class="tool__notes">
      <h2 class="tool__notes-title">How the randomness works</h2>
      <p class="tool__notes-body">
        Names are shuffled with your browser's cryptographic random number generator, so every name
        has an equal chance — and drawn names never repeat. Groups are balanced: with 23 people in 4
        groups you get groups of 6, 6, 6 and 5.
      </p>

      <h2 class="tool__notes-title">Balanced teams</h2>
      <p class="tool__notes-body">
        In Teams mode you can add a rating after any name — <code>Alice:8</code> — and the teams
        come out with near-equal total ratings. Anyone without a rating is counted at the average of
        the people who have one. Team size stays even first: with 23 people in 4 teams you get 6, 6,
        6 and 5, and only then are the ratings balanced. The highest-rated person in each team is
        marked (C) as captain.
      </p>

      <h2 class="tool__notes-title">Sharing</h2>
      <p class="tool__notes-body">
        Copy text gives you a plain list ready to paste into any chat. Download image saves a PNG
        card with the results and a small PlainKit mark in the corner.
      </p>

      <h2 class="tool__notes-title">Private by default</h2>
      <p class="tool__notes-body">
        Everything happens on your device — no server, no tracking. Your list is kept in this
        browser only so you don't have to paste it again next time; Clear list removes it right
        away.
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  import {
    computeGroupCardLayout,
    computeRevealCardLayout,
    computeTeamCardLayout,
    drawGroupCard,
    drawRevealCard,
    drawTeamCard,
  } from '@/lib/shared/canvas-card';
  import type {
    GroupCardContent,
    RevealCardContent,
    TeamCardContent,
  } from '@/lib/shared/canvas-card';
  import {
    WHEEL_JITTER,
    WHEEL_LABEL_RADIUS,
    WHEEL_MAX_NAMES,
    WHEEL_TURNS,
    advanceRotation,
    formatPickText,
    labelTransform,
    pickWinnerIndex,
    removeAt,
    sectorAngles,
    sectorLabel,
    sectorPath,
  } from '@/lib/tools/random-picker/wheel';
  import {
    assignGroups,
    balanceTeams,
    clampTeamCount,
    fillMissingRatings,
    formatGroupsText,
    formatListText,
    formatTeamsSummary,
    formatTeamsText,
    parseCount,
    parseRoster,
    pickNames,
    shuffle,
    splitNames,
    dedupeNames,
  } from '@/lib/tools/random-picker';
  import type { RandomSource, RosterEntry, Team } from '@/lib/tools/random-picker';

  const MAX_NAMES = 300;
  const STORAGE_KEY = 'plainkit.random-picker.names';

  type Mode = 'groups' | 'pick' | 'order' | 'teams' | 'wheel';
  type GroupBy = 'count' | 'size';

  /** SVG 命名空间——createElement 建不出 SVG 元素，必须用 createElementNS。 */
  const SVG_NS = 'http://www.w3.org/2000/svg';

  /** 最近一次成功生成的结果，供 Regenerate / Copy / Download 使用。 */
  interface PickerResult {
    mode: Mode;
    groupBy: GroupBy;
    param: number;
    /** 通用渲染用的分块（分组 / 抽人 / 排序 / 分队） */
    groups: { label: string; members: string[] }[];
    members: string[];
    /** 分队模式的结构化结果（复制文本与卡片用） */
    teams: Team[] | null;
    /** 本次是否用到了评分 */
    rated: boolean;
    /** 结果读数文案，如 "23 vs 22" */
    summary: string;
    modeLabel: string;
  }

  /** 加密安全的随机源（BR-003）。 */
  const cryptoRandom: RandomSource = () => {
    const buffer = new Uint32Array(1);
    crypto.getRandomValues(buffer);
    return buffer[0]! / 2 ** 32;
  };

  function init(): void {
    const namesInput = document.querySelector('#names');
    const namesCount = document.querySelector('#names-count');
    const namesHint = document.querySelector('#names-hint');
    const dupWarning = document.querySelector('#dup-warning');
    const dupNames = document.querySelector('#dup-names');
    const dedupeButton = document.querySelector('#dedupe');
    const clearButton = document.querySelector('#clear');
    const modeGroups = document.querySelector('#mode-groups');
    const modePick = document.querySelector('#mode-pick');
    const modeOrder = document.querySelector('#mode-order');
    const modeTeams = document.querySelector('#mode-teams');
    const modeWheel = document.querySelector('#mode-wheel');
    const wheelField = document.querySelector('#wheel-field');
    const wheelSvg = document.querySelector('#wheel-svg');
    const wheelRotor = document.querySelector('#wheel-rotor');
    const wheelRemove = document.querySelector('#wheel-remove');
    const wheelNotes = document.querySelector('#wheel-notes');
    const wheelReset = document.querySelector('#wheel-reset');
    const teamNotes = document.querySelector('#team-notes');
    const readoutValue = document.querySelector('#readout-value');
    const groupByField = document.querySelector('#group-by-field');
    const groupBySelect = document.querySelector('#group-by');
    const paramField = document.querySelector('#param-field');
    const paramLabel = document.querySelector('#param-label');
    const paramInput = document.querySelector('#param');
    const paramError = document.querySelector('#param-error');
    const generateButton = document.querySelector('#generate');
    const readout = document.querySelector('#readout');
    const resultBox = document.querySelector('#result');
    const readoutNote = document.querySelector('#readout-note');
    const regenerateButton = document.querySelector('#regenerate');
    const copyButton = document.querySelector('#copy-text');
    const downloadButton = document.querySelector('#download-image');

    if (
      !(namesInput instanceof HTMLTextAreaElement) ||
      !(namesCount instanceof HTMLElement) ||
      !(namesHint instanceof HTMLElement) ||
      !(dupWarning instanceof HTMLElement) ||
      !(dupNames instanceof HTMLElement) ||
      !(dedupeButton instanceof HTMLButtonElement) ||
      !(modeGroups instanceof HTMLInputElement) ||
      !(modePick instanceof HTMLInputElement) ||
      !(modeOrder instanceof HTMLInputElement) ||
      !(modeTeams instanceof HTMLInputElement) ||
      !(modeWheel instanceof HTMLInputElement) ||
      !(wheelField instanceof HTMLElement) ||
      !(wheelSvg instanceof SVGElement) ||
      !(wheelRotor instanceof SVGElement) ||
      !(wheelRemove instanceof HTMLInputElement) ||
      !(wheelNotes instanceof HTMLElement) ||
      !(wheelReset instanceof HTMLButtonElement) ||
      !(teamNotes instanceof HTMLElement) ||
      !(readoutValue instanceof HTMLElement) ||
      !(groupByField instanceof HTMLElement) ||
      !(groupBySelect instanceof HTMLSelectElement) ||
      !(paramField instanceof HTMLElement) ||
      !(paramLabel instanceof HTMLElement) ||
      !(paramInput instanceof HTMLInputElement) ||
      !(paramError instanceof HTMLElement) ||
      !(generateButton instanceof HTMLButtonElement) ||
      !(readout instanceof HTMLElement) ||
      !(resultBox instanceof HTMLElement) ||
      !(readoutNote instanceof HTMLElement) ||
      !(regenerateButton instanceof HTMLButtonElement) ||
      !(copyButton instanceof HTMLButtonElement) ||
      !(downloadButton instanceof HTMLButtonElement)
    ) {
      throw new Error('random-picker: required elements not found');
    }

    const clearButton2 = clearButton instanceof HTMLButtonElement ? clearButton : null;
    const modeRadios = [modeGroups, modePick, modeOrder, modeTeams, modeWheel];
    let lastResult: PickerResult | null = null;
    let copyResetTimer = 0;
    /** 用户是否动过名单框——初始空状态不显示红色引导（与 grade-calculator 同约定）。 */
    let namesTouched = false;

    // ── 转盘状态（BR-018：这些都不写 localStorage，切模式或改名单即重置）──
    /** 当前盘面上的名字（连抽会越来越少）。 */
    let wheelNames: string[] = [];
    /** 完整名单的人数，用于判断「有人被抽走了」与显示 Reset。 */
    let wheelFullCount = 0;
    /** 累计旋转角度（只增不减，保证每次都往前转）。 */
    let wheelRotation = 0;
    /** 本次旋转的参与人数（用作结果抬头的「Picked from N names」）。 */
    let wheelFieldSize = 0;
    /** 高亮的扇区索引；移除中签者后索引失效，置回 null。 */
    let wheelWinnerIndex: number | null = null;
    /** 旋转进行中——用于禁用 Spin，防止连点（AC-054）。 */
    let wheelSpinning = false;
    /** 是否转过至少一次（决定按钮文案是 Spin 还是 Spin again）。 */
    let wheelSpun = false;

    const view = {
      namesInput,
      namesCount,
      namesHint,
      dupWarning,
      dupNames,
      dedupeButton,
      teamNotes,
      readoutValue,
      groupByField,
      groupBySelect,
      paramField,
      paramLabel,
      paramInput,
      paramError,
      generateButton,
      readout,
      resultBox,
      readoutNote,
      regenerateButton,
      copyButton,
      downloadButton,
      wheelField,
      wheelSvg,
      wheelRotor,
      wheelRemove,
      wheelNotes,
      wheelReset,
    };

    const currentMode = (): Mode => {
      const checked = modeRadios.find((radio) => radio.checked);
      return (checked?.value as Mode | undefined) ?? 'groups';
    };

    /** 生成今日日期文本，如 "September 24, 2026"（en-US，确定性输出）。 */
    function todayLabel(): string {
      return new Date().toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }

    /** 参数字段的标签与可见性随模式变化。 */
    function syncParamField(): void {
      const mode = currentMode();
      const groupBy = view.groupBySelect.value as GroupBy;
      const wheel = mode === 'wheel';
      view.groupByField.hidden = mode !== 'groups';
      view.paramField.hidden = wheel || mode === 'order';
      view.wheelField.hidden = !wheel;
      // 转盘模式下「Regenerate」与 Spin again 是同一件事，不重复给两个按钮
      view.regenerateButton.hidden = wheel;
      view.generateButton.textContent = wheel ? 'Spin' : 'Generate';

      if (mode === 'groups') {
        view.paramLabel.textContent = groupBy === 'count' ? 'Number of groups' : 'People per group';
      } else if (mode === 'pick') {
        view.paramLabel.textContent = 'People to pick';
      } else if (mode === 'teams') {
        view.paramLabel.textContent = 'Number of teams';
        view.paramInput.value = '2';
        view.paramError.textContent = '';
      }
      if (mode !== 'teams') view.teamNotes.textContent = '';
    }

    /** 团队模式的名单解析：评分、重复、容量上限（AC-030 / 034 / 035 / 036）。 */
    function readTeams(): {
      entries: RosterEntry[];
      duplicates: string[];
      badRatingLines: number;
    } {
      const roster = parseRoster(view.namesInput.value);
      const entries = roster.entries.slice(0, MAX_NAMES);
      const count = entries.length;
      view.namesCount.textContent = `${count} ${count === 1 ? 'name' : 'names'}`;

      const seen = new Set<string>();
      const duplicates = new Set<string>();
      for (const entry of entries) {
        if (seen.has(entry.name)) {
          duplicates.add(entry.name);
        } else {
          seen.add(entry.name);
        }
      }
      if (duplicates.size > 0) {
        view.dupWarning.hidden = false;
        view.dupNames.textContent = `Duplicate names: ${[...duplicates].join(', ')}.`;
      } else {
        view.dupWarning.hidden = true;
      }

      view.namesHint.textContent =
        roster.entries.length > MAX_NAMES ? `Only the first ${MAX_NAMES} names are used.` : '';
      return { entries, duplicates: [...duplicates], badRatingLines: roster.badRatingLines };
    }

    /** 团队模式的生成：评分分队 + 队长（AC-019 – 031）。 */
    function generateTeams(): void {
      const { entries, badRatingLines } = readTeams();
      if (entries.length < 2) {
        renderPending('Enter at least 2 names, then press Generate.');
        return;
      }

      const filled = fillMissingRatings(entries);
      const max = filled.entries.length;
      view.paramInput.max = String(max);

      const raw = Number(view.paramInput.value.trim());
      if (!Number.isInteger(raw)) {
        view.paramError.textContent = 'Number of teams must be a whole number between 2 and 10.';
        view.paramInput.setAttribute('aria-invalid', 'true');
        renderPending('Fix the highlighted field and try again.');
        return;
      }
      const clamped = clampTeamCount(raw, max);
      if (clamped.note !== null) {
        view.paramInput.value = String(clamped.value);
        view.paramError.textContent = clamped.note;
      } else {
        view.paramError.textContent = '';
      }
      view.paramInput.removeAttribute('aria-invalid');

      const teams = balanceTeams(filled.entries, clamped.value, cryptoRandom);

      const notes: string[] = [];
      if (filled.rated && filled.unratedCount > 0) {
        notes.push(
          `${filled.unratedCount} ${filled.unratedCount === 1 ? 'person has' : 'people have'} no rating — counted as ${filled.average}.`,
        );
      }
      if (badRatingLines > 0) {
        notes.push(
          `${badRatingLines} ${badRatingLines === 1 ? 'line has' : 'lines have'} a rating we could not read — treated as a name.`,
        );
      }
      view.teamNotes.textContent = notes.join(' ');

      renderResult({
        mode: 'teams',
        groupBy: 'count',
        param: clamped.value,
        groups: teams.map((team, index) => ({
          label: filled.rated ? `Team ${index + 1} — ${team.total} pts` : `Team ${index + 1}`,
          members: team.members.map((member, i) =>
            i === team.captain ? `${member.name} (C)` : member.name,
          ),
        })),
        members: teams.flatMap((team) => team.members.map((member) => member.name)),
        teams,
        rated: filled.rated,
        summary: formatTeamsSummary(teams, filled.rated),
        modeLabel: `${filled.entries.length} names in ${clamped.value} balanced teams`,
      });
    }

    /** 名单解析 + 容量上限（AC-008 / 009 / 014）。 */
    function readNames(): string[] {
      const { names, duplicates } = splitNames(view.namesInput.value);
      view.namesCount.textContent = `${names.length} ${names.length === 1 ? 'name' : 'names'}`;

      if (duplicates.length > 0) {
        view.dupWarning.hidden = false;
        view.dupNames.textContent = `Duplicate names: ${duplicates.join(', ')}.`;
      } else {
        view.dupWarning.hidden = true;
      }

      if (names.length > MAX_NAMES) {
        view.namesHint.textContent = `Only the first ${MAX_NAMES} names are used.`;
        return names.slice(0, MAX_NAMES);
      }
      view.namesHint.textContent = '';
      return names;
    }

    function renderPending(note: string): void {
      lastResult = null;
      view.readout.dataset.state = 'pending';
      view.resultBox.hidden = true;
      view.resultBox.textContent = '';
      view.readoutNote.hidden = false;
      view.readoutNote.textContent = note;
      view.readoutValue.hidden = true;
      view.readoutValue.textContent = '';
      view.regenerateButton.disabled = true;
      view.copyButton.disabled = true;
      view.downloadButton.disabled = true;
    }

    /** 重新校验输入并更新 Generate 按钮与提示（AC-010）；未输入过的空页面不显示红色错误。 */
    function validate(): void {
      const names = readNames();
      if (currentMode() === 'wheel') {
        // 名单一改，盘面、角度、结果全部重置（AC-055）
        resetWheelFrom(names);
        if (!wheelReady()) {
          renderPending('Add at least 2 names, then press Spin.');
        }
        return;
      }
      if (names.length < 2) {
        view.generateButton.disabled = true;
        if (namesTouched && view.namesHint.textContent === '') {
          view.namesHint.textContent = 'Enter at least 2 names.';
        }
      } else {
        view.generateButton.disabled = false;
      }
    }

    function renderResult(result: PickerResult): void {
      lastResult = result;
      view.resultBox.hidden = false;
      view.resultBox.textContent = '';
      view.readoutNote.hidden = true;
      view.readout.dataset.state = 'ok';
      view.readoutValue.hidden = result.summary === '';
      view.readoutValue.textContent = result.summary;

      for (const group of result.groups) {
        const block = document.createElement('div');
        block.className = 'result__group';
        if (group.label !== '') {
          const label = document.createElement('p');
          label.className = 'result__label';
          label.textContent = group.label;
          block.append(label);
        }
        const list = document.createElement('ul');
        list.className = 'result__list';
        for (const member of group.members) {
          const item = document.createElement('li');
          item.textContent = member;
          list.append(item);
        }
        block.append(list);
        view.resultBox.append(block);
      }

      view.regenerateButton.disabled = false;
      view.copyButton.disabled = false;
      view.downloadButton.disabled = false;
    }

    /** 用当前输入计算一次随机结果（Generate 与 Regenerate 共用，AC-007）。 */
    function generate(): void {
      const mode = currentMode();
      if (mode === 'teams') {
        generateTeams();
        return;
      }
      if (mode === 'wheel') {
        spin();
        return;
      }

      view.teamNotes.textContent = '';
      const names = readNames();
      if (names.length < 2) {
        renderPending('Enter at least 2 names, then press Generate.');
        return;
      }

      const groupBy = view.groupBySelect.value as GroupBy;
      const paramLabel =
        mode === 'groups'
          ? groupBy === 'count'
            ? 'Number of groups'
            : 'People per group'
          : 'People to pick';
      const paramMax = mode === 'groups' && groupBy === 'size' ? names.length - 1 : names.length;
      view.paramInput.max = String(paramMax);

      let param = 0;
      if (mode !== 'order') {
        const parsed = parseCount(view.paramInput.value, paramMax, paramLabel);
        if (!parsed.ok) {
          view.paramError.textContent = parsed.message;
          view.paramInput.setAttribute('aria-invalid', 'true');
          renderPending('Fix the highlighted field and try again.');
          return;
        }
        view.paramError.textContent = '';
        view.paramInput.removeAttribute('aria-invalid');
        param = parsed.value;
      }

      let groups: { label: string; members: string[] }[];
      let members: string[];
      let modeLabel: string;

      if (mode === 'groups') {
        const groupCount = groupBy === 'count' ? param : Math.ceil(names.length / param);
        const assigned = assignGroups(names, groupCount, cryptoRandom);
        groups = assigned.map((group, index) => ({ label: `Group ${index + 1}`, members: group }));
        members = assigned.flat();
        modeLabel = `${names.length} names in ${groupCount} groups`;
      } else if (mode === 'pick') {
        members = pickNames(names, param, cryptoRandom);
        groups = [{ label: '', members }];
        modeLabel = `${param} picked from ${names.length} names`;
      } else {
        members = shuffle(names, cryptoRandom);
        groups = [{ label: '', members }];
        modeLabel = `${names.length} names in random order`;
      }

      renderResult({
        mode,
        groupBy,
        param,
        groups,
        members,
        teams: null,
        rated: false,
        summary: '',
        modeLabel,
      });
    }

    // ── 转盘（Wheel 模式）──────────────────────────────────────────────
    // 扇区几何与文字截断全部由 wheel.ts 的纯函数算好，这里只把结果搬进 DOM。

    /** 扇区文字要按真实字体宽度截断，用一块离屏 canvas 做测量。 */
    let measureCanvas: HTMLCanvasElement | null = null;
    function wheelMeasure(): (text: string, px: number) => number {
      if (measureCanvas === null) measureCanvas = document.createElement('canvas');
      const ctx = measureCanvas.getContext('2d');
      // 拿不到 2d 上下文时退回一个粗略估算——标签略宽总比不显示好
      if (!ctx) return (text, px) => text.length * px * 0.6;
      return (text, px) => {
        ctx.font = `400 ${px}px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
        return ctx.measureText(text).width;
      };
    }

    /** 重建盘面（AC-042 / 052）。旋转角度挂在 svg 上，不随重建丢失。 */
    function renderWheel(): void {
      view.wheelRotor.textContent = '';
      const count = wheelNames.length;
      // 转不了的名单不画盘——画一个转不动的轮子只会让人以为它坏了
      if (!wheelReady()) return;
      const step = 360 / count;
      const measure = wheelMeasure();

      for (const sector of sectorAngles(count)) {
        const win = wheelWinnerIndex === sector.index;
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('d', sectorPath(sector));
        path.setAttribute(
          'class',
          `wheel__sector${sector.index % 2 === 1 ? ' wheel__sector--alt' : ''}${
            win ? ' wheel__sector--win' : ''
          }`,
        );
        view.wheelRotor.append(path);

        const label = sectorLabel(wheelNames[sector.index] ?? '', step, measure);
        if (!label.visible) continue;
        const text = document.createElementNS(SVG_NS, 'text');
        text.setAttribute('class', win ? 'wheel__label wheel__label--win' : 'wheel__label');
        text.setAttribute('transform', labelTransform(sector.center, WHEEL_LABEL_RADIUS));
        text.setAttribute('text-anchor', 'end');
        text.setAttribute('dominant-baseline', 'central');
        text.setAttribute('font-size', String(label.fontSize));
        text.textContent = label.text;
        view.wheelRotor.append(text);
      }
    }

    /** 盘下方的说明行与 Reset 可见性（AC-047 / 050 / 051）。 */
    function updateWheelNotes(): void {
      const count = wheelNames.length;
      const removed = wheelFullCount - count;
      view.wheelReset.hidden = count >= wheelFullCount;

      if (count === 0 && wheelFullCount > 0) {
        view.wheelNotes.textContent = 'Everyone has been picked. Reset to start over.';
        return;
      }
      if (count > WHEEL_MAX_NAMES) {
        view.wheelNotes.textContent = `The wheel holds up to ${WHEEL_MAX_NAMES} names — use Pick names for a longer list.`;
        return;
      }
      // 一份没动过的名单只有 1 个人时没什么可随机，照旧劝退（AC-051）
      if (removed === 0 && count < 2) {
        view.wheelNotes.textContent = 'Add at least 2 names to spin.';
        return;
      }
      view.wheelNotes.textContent =
        removed > 0 ? `${removed} already picked — ${count} left on the wheel.` : '';
    }

    /**
     * 转盘能不能转。
     *
     * 常规门槛是 2 人（AC-051）；但连抽抽到最后只剩 1 人时允许再转一次，
     * 否则最后一个人既转不出来、也走不到「全都抽完了」这个收尾状态（AC-047）。
     */
    function wheelReady(): boolean {
      const count = wheelNames.length;
      if (count > WHEEL_MAX_NAMES) return false;
      return count >= 2 || (count === 1 && count < wheelFullCount);
    }

    function updateSpinButton(): void {
      view.generateButton.disabled = !wheelReady() || wheelSpinning;
      view.generateButton.textContent = wheelSpun ? 'Spin again' : 'Spin';
    }

    /** 应用旋转角度。`animate = false` 用于复位——复位本身不能带动画。 */
    function applyRotation(degrees: number, animate: boolean): void {
      if (!animate) view.wheelSvg.style.transition = 'none';
      view.wheelSvg.style.transform = `rotate(${degrees}deg)`;
      if (!animate) {
        void view.wheelSvg.getBoundingClientRect(); // 强制重排，让复位立即生效
        view.wheelSvg.style.transition = '';
      }
    }

    /** 旋转时长直接读 CSS：reduced-motion 下会被全局规则压到 0.01ms（AC-056）。 */
    function spinDurationMs(): number {
      const seconds = Number.parseFloat(window.getComputedStyle(view.wheelSvg).transitionDuration);
      return Number.isFinite(seconds) ? seconds * 1000 : 0;
    }

    /** 用一份名单重建转盘状态（AC-055：改名单 / 切模式 / 去重都会走这里）。 */
    function resetWheelFrom(names: string[]): void {
      wheelNames = names;
      wheelFullCount = names.length;
      wheelWinnerIndex = null;
      wheelSpinning = false;
      wheelSpun = false;
      wheelRotation = 0;
      applyRotation(0, false);
      renderWheel();
      updateWheelNotes();
      updateSpinButton();
    }

    function resetWheel(): void {
      resetWheelFrom(readNames());
    }

    /** 把中签者写进读数并启用导出（AC-043 / 048 / 049）。 */
    function revealWinner(winner: string | null): void {
      if (winner === null) {
        renderPending('Add at least 2 names, then press Spin.');
        return;
      }
      renderResult({
        mode: 'wheel',
        groupBy: 'count',
        param: 0,
        groups: [],
        members: [winner],
        teams: null,
        rated: false,
        summary: winner,
        modeLabel: `Picked from ${wheelFieldSize} names`,
      });
    }

    /**
     * 转一次。**先算中签者，再反推角度**（BR-015）：
     * 反过来做会在浮点误差下产生偏差，而「先转后定」是假随机。
     */
    function spin(): void {
      const count = wheelNames.length;
      if (wheelSpinning || !wheelReady()) return;

      const index = pickWinnerIndex(count, cryptoRandom);
      const step = 360 / count;
      const jitter = (cryptoRandom() * 2 - 1) * WHEEL_JITTER * (step / 2);
      wheelRotation = advanceRotation(wheelRotation, index, count, WHEEL_TURNS, jitter);
      wheelFieldSize = count;

      wheelSpinning = true;
      wheelSpun = true;
      wheelWinnerIndex = null;
      renderWheel(); // 清掉上一次的高亮
      updateSpinButton(); // AC-054：旋转中禁用 Spin
      applyRotation(wheelRotation, true);

      window.setTimeout(() => {
        wheelSpinning = false;
        const winner = wheelNames[index] ?? null;
        if (view.wheelRemove.checked) {
          wheelNames = removeAt(wheelNames, index);
          wheelWinnerIndex = null; // 移除后索引失效，高亮取消
        } else {
          wheelWinnerIndex = index;
        }
        renderWheel();
        updateWheelNotes();
        updateSpinButton();
        revealWinner(winner);
      }, spinDurationMs() + 60);
    }

    // ── 输入与名单持久化（AC-008 / 016）─────────────────────────────────
    let clearArmed = false;
    let clearResetTimer = 0;

    function resetClearButton(): void {
      clearArmed = false;
      if (clearButton2) clearButton2.textContent = 'Clear list';
    }

    view.namesInput.addEventListener('input', () => {
      namesTouched = true;
      window.localStorage.setItem(STORAGE_KEY, view.namesInput.value);
      validate();
    });

    view.dedupeButton.addEventListener('click', () => {
      const { names } = splitNames(view.namesInput.value);
      view.namesInput.value = dedupeNames(names).join('\n');
      window.localStorage.setItem(STORAGE_KEY, view.namesInput.value);
      validate();
    });

    if (clearButton2) {
      clearButton2.addEventListener('click', () => {
        if (!clearArmed) {
          clearArmed = true;
          clearButton2.textContent = 'Click again to confirm';
          window.clearTimeout(clearResetTimer);
          clearResetTimer = window.setTimeout(resetClearButton, 3000);
          return;
        }
        window.clearTimeout(clearResetTimer);
        resetClearButton();
        view.namesInput.value = '';
        window.localStorage.removeItem(STORAGE_KEY);
        validate();
        renderPending('Enter at least 2 names, then press Generate.');
      });
    }

    // ── 模式与参数（AC-011 / 012）───────────────────────────────────────
    for (const radio of modeRadios) {
      radio.addEventListener('change', () => {
        syncParamField();
        // 换模式等于换一种结果，旧结果（尤其是转盘抽出的名字）不该留在读数里
        renderPending('Enter at least 2 names, then press Generate.');
        validate();
      });
    }

    view.wheelReset.addEventListener('click', () => {
      resetWheel();
      renderPending('Spin the wheel to pick a name.');
    });
    view.groupBySelect.addEventListener('change', () => {
      syncParamField();
      validate();
    });
    view.paramInput.addEventListener('input', () => {
      view.paramError.textContent = '';
      view.paramInput.removeAttribute('aria-invalid');
    });

    view.generateButton.addEventListener('click', generate);
    view.regenerateButton.addEventListener('click', generate);

    // ── 复制文本（AC-006）───────────────────────────────────────────────
    function resultText(result: PickerResult): string {
      const header = `${result.modeLabel} · ${todayLabel()} · PlainKit`;
      if (result.mode === 'wheel') {
        return formatPickText(result.members[0] ?? '', header);
      }
      if (result.teams) {
        return formatTeamsText(result.teams, header, result.rated);
      }
      if (result.groups.length === 1 && result.groups[0]!.label === '') {
        return formatListText(result.members, header);
      }
      return formatGroupsText(
        result.groups.map((group) => group.members),
        header,
      );
    }

    function resetCopyLabelLater(): void {
      window.clearTimeout(copyResetTimer);
      copyResetTimer = window.setTimeout(() => {
        view.copyButton.textContent = 'Copy text';
      }, 2000);
    }

    view.copyButton.addEventListener('click', () => {
      if (!lastResult) return;
      const write = navigator.clipboard?.writeText(resultText(lastResult));
      if (!write) {
        view.copyButton.textContent = 'Copying is not available in this browser';
        resetCopyLabelLater();
        return;
      }
      write
        .then(() => {
          view.copyButton.textContent = 'Copied';
        })
        .catch(() => {
          view.copyButton.textContent = 'Copying was blocked';
        })
        .finally(resetCopyLabelLater);
    });

    // ── 图片导出（AC-005）：1080 宽、高度随内容 ────────────────────────
    view.downloadButton.addEventListener('click', () => {
      if (!lastResult) return;
      const result = lastResult;

      const canvas = document.createElement('canvas');
      canvas.width = 1080;
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        view.downloadButton.textContent = 'Not available in this browser';
        return;
      }
      const measure = (text: string, px: number) => {
        ctx.font = `400 ${px}px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
        return ctx.measureText(text).width;
      };

      let filename = 'random-groups.png';
      if (result.mode === 'wheel') {
        const reveal: RevealCardContent = {
          title: 'Picked',
          name: result.members[0] ?? '',
          note: result.modeLabel,
          dateLabel: todayLabel(),
        };
        canvas.height = computeRevealCardLayout(reveal, measure).height;
        drawRevealCard(ctx, reveal);
        filename = 'wheel-pick.png';
      } else if (result.teams) {
        const teamContent: TeamCardContent = {
          title: '',
          modeLabel: result.modeLabel,
          teams: result.teams.map((team, index) => ({
            label: `Team ${index + 1}`,
            totalLabel: result.rated ? `${team.total} pts` : '',
            members: team.members.map((member, i) =>
              i === team.captain ? `${member.name} (C)` : member.name,
            ),
          })),
          dateLabel: todayLabel(),
        };
        canvas.height = computeTeamCardLayout(teamContent, measure).height;
        drawTeamCard(ctx, teamContent);
        filename = 'random-teams.png';
      } else {
        const content: GroupCardContent = {
          title: '',
          modeLabel: result.modeLabel,
          groups: result.groups,
          dateLabel: todayLabel(),
        };
        canvas.height = computeGroupCardLayout(content, measure).height;
        drawGroupCard(ctx, content);
      }

      canvas.toBlob((blob) => {
        if (!blob) {
          view.downloadButton.textContent = 'Export failed — try again';
          return;
        }
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = filename;
        link.click();
        URL.revokeObjectURL(link.href);
      }, 'image/png');
    });

    // ── 初始化：恢复上次的名单（AC-016）────────────────────────────────
    const saved = window.localStorage.getItem(STORAGE_KEY);
    if (saved !== null) view.namesInput.value = saved;

    // 页面里没有独立 clear 按钮的兜底：把清除动作挂在名单计数旁由模板提供
    syncParamField();
    validate();
    renderPending('Enter at least 2 names, then press Generate.');
  }

  // 顶层保护：任何未预期的错误不得导致整页白屏（DESIGN.md §9.3）
  try {
    init();
  } catch {
    // 页面无 JS 时本来就完整可读（渐进增强），这里保持静默
  }
</script>

<style>
  .bench__label-hint {
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .bench__input--area {
    resize: vertical;
    font-family: inherit;
  }

  .link-btn {
    border: 0;
    padding: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  .bench__error--action {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* 团队模式的说明行：是提示不是报错，所以用弱化色而不是错误色 */
  .bench__note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* display:flex 会覆盖 hidden 属性的默认样式，必须显式压回 */
  .bench__error--action[hidden] {
    display: none;
  }

  .bench__clear {
    display: block;
    margin-top: var(--space-2);
  }

  /* 模式切换：与倒计时卡片主题选项同一套视觉 */
  .mode-switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .mode-switch__option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    cursor: pointer;
    transition:
      border-color var(--dur-state) var(--ease-out),
      background-color var(--dur-state) var(--ease-out);
  }

  .mode-switch__option:hover {
    border-color: var(--ink-faint);
  }

  .mode-switch__option:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .mode-switch__option input {
    accent-color: var(--accent);
  }

  /* 结果区：分组按列排布，窄屏自动降为单列 */
  .result {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-5);
    width: 100%;
    text-align: left;
  }

  .result__group {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .result__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .result__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-base);
    line-height: 1.7;
  }

  /* ── 转盘（Wheel 模式）───────────────────────────────────────────────
     扇区只用 surface / surface-alt 两色交替，中签扇区用 accent-wash。
     不新增颜色令牌——彩色轮盘是竞品的视觉语言，也是老虎机的视觉语言。 */
  .wheel {
    position: relative;
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
  }

  .wheel__svg {
    display: block;
    width: 100%;
    height: auto;
    /* 全站唯一的超长动效：一次性、非循环（BR-017 / DESIGN.md §6-bis.7） */
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .wheel__pointer {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 22px;
    height: 22px;
    transform: translateX(-50%);
    fill: var(--ink);
    pointer-events: none;
  }

  .wheel__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-base);
    cursor: pointer;
  }

  .wheel__toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .wheel__reset {
    display: block;
    margin-top: var(--space-2);
  }

  /* 同上：display: block 会盖掉 hidden 的 display: none */
  .wheel__reset[hidden] {
    display: none;
  }

  /* 中签名字可能很长：允许折行，绝不截断（结果必须完整可见） */
  .readout__value {
    overflow-wrap: anywhere;
  }
</style>

<!-- 扇区与扇区文字是 JS 动态创建的，拿不到 Astro 的 scoped 属性，
     用 scoped 选择器会静默不生效（扇区会落回 SVG 默认的黑色填充）。
     颜色照抄设计令牌，不自创。 -->
<style is:global>
  .wheel__sector {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }

  .wheel__sector--alt {
    fill: var(--surface-alt);
  }

  /* 放在最后：中签高亮要盖过交替底色 */
  .wheel__sector--win {
    fill: var(--accent-wash);
  }

  .wheel__label {
    fill: var(--ink);
    font-family: var(--font-sans);
  }

  .wheel__label--win {
    fill: var(--accent);
  }
</style>
